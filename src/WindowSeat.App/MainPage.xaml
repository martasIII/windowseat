<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="WindowSeat.App.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <ContentPage.Resources>
        <Style x:Key="Readout" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="monospace" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="PlaceholderColor" Value="#888780" />
            <Setter Property="BackgroundColor" Value="#33FFFFFF" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <toolkit:CameraView x:Name="Camera" />

        <GraphicsView x:Name="Overlay">
            <GraphicsView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <!-- Živé hodnoty senzorů: kontrola, že orientace a poloha dávají smysl. -->
        <Border VerticalOptions="Start"
                Margin="12,40,12,0"
                Padding="12,8"
                StrokeThickness="0"
                BackgroundColor="#99000000"
                InputTransparent="True">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Label x:Name="PoseLabel" Style="{StaticResource Readout}" Text="Orientace: čekám…" />
                <Label x:Name="LocationLabel" Style="{StaticResource Readout}" Text="Poloha: čekám…" />
                <Label x:Name="StatusLabel" TextColor="#FFB4B2A9" FontSize="13" IsVisible="False" />
            </VerticalStackLayout>
        </Border>

        <!-- Záměrný kříž uprostřed: tam míří osa kamery. -->
        <Grid HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" InputTransparent="True">
            <BoxView Color="White" HeightRequest="2" />
            <BoxView Color="White" WidthRequest="2" />
        </Grid>

        <!-- Nastavení pro ladění ze země. -->
        <VerticalStackLayout VerticalOptions="End" Margin="12,0,12,24" Spacing="8">
            <Border x:Name="HintPanel"
                    IsVisible="False"
                    Padding="14,10"
                    StrokeThickness="0"
                    BackgroundColor="#E6712B13">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label x:Name="HintLabel" TextColor="White" FontSize="15" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Zrušit" Clicked="OnCalibrationCancelled"
                            BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" />
                </Grid>
            </Border>

            <Border x:Name="SettingsPanel"
                    IsVisible="False"
                    Padding="14,10"
                    StrokeThickness="0"
                    BackgroundColor="#CC000000">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Směr kamery" Style="{StaticResource SettingLabel}" />
                    <Picker x:Name="HeadingPicker"
                            TextColor="White"
                            BackgroundColor="#33FFFFFF"
                            SelectedIndexChanged="OnSettingsChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Kompas (venku pěšky)</x:String>
                                <x:String>Kurz GPS, levé okno</x:String>
                                <x:String>Kurz GPS, pravé okno</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <Label Text="Ruční poloha" Style="{StaticResource SettingLabel}" />
                        <Switch x:Name="ManualPositionSwitch" Grid.Column="1" Toggled="OnSettingsChanged" />
                    </Grid>
                    <Entry x:Name="PositionEntry"
                           Placeholder="50.0786189N, 14.3194294E"
                           Keyboard="Text"
                           Completed="OnSettingsChanged"
                           Unfocused="OnSettingsChanged" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Ruční výška" Style="{StaticResource SettingLabel}" />
                        <Switch x:Name="ManualAltitudeSwitch" Grid.Column="1" Toggled="OnSettingsChanged" />
                    </Grid>
                    <Entry x:Name="AltitudeEntry"
                           Placeholder="metry nad mořem"
                           Keyboard="Numeric"
                           Completed="OnSettingsChanged"
                           Unfocused="OnSettingsChanged" />

                    <Label x:Name="FieldOfViewLabel" Style="{StaticResource SettingLabel}" Margin="0,6,0,0" />
                    <Slider x:Name="FieldOfViewSlider"
                            Minimum="20"
                            Maximum="90"
                            ValueChanged="OnFieldOfViewChanged" />

                    <Label x:Name="CorrectionLabel" Style="{StaticResource SettingLabel}" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Kalibrovat na cíl" Clicked="OnCalibrateClicked" />
                        <Button Grid.Column="1" Text="Zrušit opravu" Clicked="OnResetCorrectionClicked"
                                BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" />
                    </Grid>

                    <Label x:Name="DataLabel" TextColor="#B4B2A9" FontSize="12" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="SettingsButton"
                    Text="Nastavení"
                    HorizontalOptions="End"
                    BackgroundColor="#CC000000"
                    TextColor="White"
                    Clicked="OnSettingsClicked" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
