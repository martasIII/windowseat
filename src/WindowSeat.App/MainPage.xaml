<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="WindowSeat.App.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <ContentPage.Resources>
        <Style x:Key="Readout" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="monospace" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="PlaceholderColor" Value="#888780" />
            <Setter Property="BackgroundColor" Value="#33FFFFFF" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <toolkit:CameraView x:Name="Camera" />

        <GraphicsView x:Name="Overlay">
            <GraphicsView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <!-- Stav v jednom řádku; klepnutím se rozbalí živé hodnoty senzorů. -->
        <Border VerticalOptions="Start"
                HorizontalOptions="Start"
                Margin="12,36,12,0"
                Padding="12,5"
                StrokeThickness="0"
                BackgroundColor="#99000000">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnStatusTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="2">
                <Label x:Name="StatusLine" Style="{StaticResource Readout}" Text="Čekám na senzory…" />
                <VerticalStackLayout x:Name="StatusDetails" IsVisible="False" Spacing="2" Margin="0,4,0,0">
                    <Label x:Name="PoseLabel" Style="{StaticResource Readout}" Text="Orientace: čekám…" />
                    <Label x:Name="LocationLabel" Style="{StaticResource Readout}" Text="Poloha: čekám…" />
                </VerticalStackLayout>
                <Label x:Name="StatusLabel" TextColor="#FFB4B2A9" FontSize="13" IsVisible="False" />
            </VerticalStackLayout>
        </Border>

        <!-- Nastavení pro ladění ze země. -->
        <VerticalStackLayout VerticalOptions="End" Margin="12,0,12,24" Spacing="8">
            <Border x:Name="HintPanel"
                    IsVisible="False"
                    Padding="14,10"
                    StrokeThickness="0"
                    BackgroundColor="#E6712B13">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label x:Name="HintLabel" TextColor="White" FontSize="15" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Zrušit" Clicked="OnCalibrationCancelled"
                            BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" />
                </Grid>
            </Border>

            <!-- Detail místa po klepnutí na popisek. -->
            <Border x:Name="DetailCard"
                    IsVisible="False"
                    Padding="14,10"
                    StrokeThickness="0"
                    BackgroundColor="#E6000000">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="DetailName" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="DetailMeta" TextColor="#B4B2A9" FontSize="13" />
                        <Label x:Name="DetailDescription" TextColor="White" FontSize="14" Margin="0,4,0,0" />
                        <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="WikipediaButton" Text="Wikipedie" Clicked="OnWikipediaClicked"
                                    BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" Padding="12,4" />
                            <Button x:Name="NavigateButton" Text="Navigovat" Clicked="OnNavigateClicked"
                                    BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" Padding="12,4" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="✕" VerticalOptions="Start" Clicked="OnDetailClosed"
                            BackgroundColor="Transparent" TextColor="White" Padding="8,0" />
                </Grid>
            </Border>

            <Border x:Name="SettingsPanel"
                    IsVisible="False"
                    Padding="14,10"
                    StrokeThickness="0"
                    BackgroundColor="#CC000000">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <ScrollView MaximumHeightRequest="560">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Dosah (vrcholy dvojnásobně)" Style="{StaticResource SettingLabel}" FontAttributes="Bold" />
                        <Picker x:Name="RangePicker" Grid.Column="1" WidthRequest="120"
                                TextColor="White" BackgroundColor="#33FFFFFF"
                                SelectedIndexChanged="OnRangeChanged" />
                    </Grid>

                    <Label Text="Vrstvy a jejich přednost" Style="{StaticResource SettingLabel}" FontAttributes="Bold" Margin="0,8,0,0" />
                    <VerticalStackLayout x:Name="LayersPanel" Spacing="4" />

                    <Label Text="Směr kamery" Style="{StaticResource SettingLabel}" FontAttributes="Bold" Margin="0,8,0,0" />
                    <Picker x:Name="HeadingPicker"
                            TextColor="White"
                            BackgroundColor="#33FFFFFF"
                            SelectedIndexChanged="OnSettingsChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Kompas (venku pěšky)</x:String>
                                <x:String>Kurz GPS, levé okno</x:String>
                                <x:String>Kurz GPS, pravé okno</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <Label Text="Ruční poloha" Style="{StaticResource SettingLabel}" />
                        <Switch x:Name="ManualPositionSwitch" Grid.Column="1" Toggled="OnSettingsChanged" />
                    </Grid>
                    <Entry x:Name="PositionEntry"
                           Placeholder="50.0786189N, 14.3194294E"
                           Keyboard="Text"
                           Completed="OnSettingsChanged"
                           Unfocused="OnSettingsChanged" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Ruční výška" Style="{StaticResource SettingLabel}" />
                        <Switch x:Name="ManualAltitudeSwitch" Grid.Column="1" Toggled="OnSettingsChanged" />
                    </Grid>
                    <Entry x:Name="AltitudeEntry"
                           Placeholder="metry nad mořem"
                           Keyboard="Numeric"
                           Completed="OnSettingsChanged"
                           Unfocused="OnSettingsChanged" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <Label x:Name="FieldOfViewLabel" Style="{StaticResource SettingLabel}" />
                        <Button Grid.Column="1" Text="Automaticky" Clicked="OnAutomaticFieldOfViewClicked"
                                BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" />
                    </Grid>
                    <Slider x:Name="FieldOfViewSlider"
                            Minimum="15"
                            Maximum="90"
                            ValueChanged="OnFieldOfViewChanged" />

                    <Label x:Name="CorrectionLabel" Style="{StaticResource SettingLabel}" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Kalibrovat na cíl" Clicked="OnCalibrateClicked" />
                        <Button Grid.Column="1" Text="Zrušit opravu" Clicked="OnResetCorrectionClicked"
                                BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" />
                    </Grid>

                    <Label x:Name="DataLabel" TextColor="#B4B2A9" FontSize="12" Margin="0,6,0,0" />
                </VerticalStackLayout>
                </ScrollView>
            </Border>

            <Button x:Name="SettingsButton"
                    Text="Nastavení"
                    HorizontalOptions="End"
                    BackgroundColor="#CC000000"
                    TextColor="White"
                    Clicked="OnSettingsClicked" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
